{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker --version)",
      "Bash(docker compose version)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-list:*)",
      "Bash(git show:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sdd-validate.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sdd-validate.ps1:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose build:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials*.json)",
      "Read(./**/service-account*.json)",
      "Bash(cat .env:*)",
      "Bash(type .env:*)",
      "Bash(Get-Content .env:*)",
      "Bash(printenv:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker compose rm:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(docker rm:*)",
      "Bash(*docker-reset.ps1*)",
      "Bash(rm -rf:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(git branch -df:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout .:*)",
      "Bash(git restore .:*)",
      "Bash(git reset --merge:*)",
      "Bash(git filter-branch:*)"
    ]
  }
}
