# Plantilla de variables para desarrollo local. Copiar a .env y reemplazar los marcadores.
# NUNCA escribir aquí credenciales reales: este archivo se versiona en Git.

# --- MongoDB (contenedor `mongo`) ---
MONGO_ROOT_USER=cambiar_usuario
MONGO_ROOT_PASSWORD=cambiar_contrasena_segura
# La misma contraseña codificada para URL (por ejemplo, % -> %25, @ -> %40).
# Se usa solo dentro de URIs mongodb://. Ver docs/onboarding/02-variables-entorno.md
MONGO_ROOT_PASSWORD_URLENCODED=cambiar_contrasena_segura
MONGO_DB=omr_preicfes
MONGO_PORT=27017

# --- Redis (contenedor `redis`, colas BullMQ) ---
REDIS_PORT=6379

# --- Para NestJS ejecutándose en el host (fuera de Docker) ---
MONGODB_URI=mongodb://cambiar_usuario:cambiar_contrasena_segura@localhost:27017/omr_preicfes?authSource=admin
REDIS_URL=redis://localhost:6379/0

# =====================================================================
# --- Autenticación (HT-AUTH-01, plan §9.4) ---
# Ningún vencimiento ni umbral está en el código: si falta una variable o tiene
# formato inválido, la API no arranca (RNF-04). Formatos:
#   duración  <entero><ms|s|m|h|d>     p. ej. 15m, 24h, 7d
#   límite    <máximo>/<ventana>       p. ej. 60/15m
# =====================================================================
NODE_ENV=development

# Origen público del frontend para los enlaces de correo (RN-13). Fuera de local: https.
APP_PUBLIC_URL=http://localhost:5173
# Orígenes completos permitidos (coma), sin ruta, sin * y sin null; incluye APP_PUBLIC_URL (DEC-20).
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Secretos: valor aleatorio de al menos 32 caracteres, distinto en cada entorno.
JWT_ACCESS_SECRET=cambiar_por_valor_aleatorio_de_32_o_mas_caracteres
RATE_LIMIT_KEY_PEPPER=cambiar_por_valor_aleatorio_de_32_o_mas_caracteres
AUDIT_IP_PEPPER=cambiar_por_valor_aleatorio_de_32_o_mas_caracteres

# Vencimientos (DEC-15; activación DEC-08)
JWT_ACCESS_TTL=15m
SESSION_REFRESH_TTL=7d
VERIFY_TOKEN_TTL=24h
RESET_TOKEN_TTL=30m
ACTIVATION_TOKEN_TTL=24h
# Tiempo mínimo de respuesta de register, resend-verification y password/forgot (RN-04)
AUTH_MIN_RESPONSE_MS=400

# Límites de intentos (DEC-15; valores propuestos, a validar antes del release)
RATE_LIMIT_LOGIN_IP_FAILURE=60/15m
RATE_LIMIT_LOGIN_CHALLENGE_IP=60/15m
RATE_LIMIT_LOGIN_CHALLENGE_ACCOUNT=5/15m
RATE_LIMIT_REGISTER_EMAIL=3/1h
RATE_LIMIT_REGISTER_IP=20/1h
RATE_LIMIT_RESEND_ACCOUNT=3/1h
RATE_LIMIT_RESEND_IP=30/1h
RATE_LIMIT_VERIFY_TOKEN=10/15m
RATE_LIMIT_VERIFY_IP=30/15m
RATE_LIMIT_FORGOT_ACCOUNT=3/1h
RATE_LIMIT_FORGOT_IP=30/1h
RATE_LIMIT_RESET_TOKEN=5/15m
RATE_LIMIT_RESET_IP=30/15m
RATE_LIMIT_ACTIVATE_TOKEN=5/15m
RATE_LIMIT_ACTIVATE_IP=30/15m
RATE_LIMIT_REDIS_TIMEOUT_MS=500
# Saltos de proxy confiables para obtener la IP real; 0 en local.
TRUST_PROXY_HOPS=0
# Tope de rotaciones del token de renovación por sesión (DEC-01)
SESSION_MAX_ROTATIONS=1000

# CAPTCHA adaptativo (DEC-16). Proveedor aprobado: Cloudflare Turnstile Managed (DEC-24).
# `test` solo se admite en desarrollo y pruebas; fuera de local, CAPTCHA_PROVIDER=turnstile y
# CAPTCHA_SECRET (obligatorio, del gestor de secretos; nunca en Git). CAPTCHA_SITE_KEY es del widget
# (historia de frontend) y el backend no la lee. Los hostnames válidos salen de AUTH_ALLOWED_ORIGINS.
CAPTCHA_PROVIDER=test
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
CAPTCHA_VERIFY_TIMEOUT_MS=3000

# Protección de recursos (DEC-17). SOLO LOCAL, NO VALIDADOS: los valores de producción
# salen de las pruebas de carga de T-43.
RATE_LIMIT_AUTH_GLOBAL=300/1m
ARGON2_MAX_CONCURRENCY=2
ARGON2_QUEUE_MAX=16
ARGON2_QUEUE_TIMEOUT_MS=2000
UV_THREADPOOL_SIZE=4
AUTH_OVERLOAD_RETRY_AFTER_S=5

# Correo (DEC-09). En local: Mailpit del perfil `mail-dev` (DEC-05), nunca en producción.
# Levantar Mailpit: docker compose --profile mail-dev up -d mailpit
# SMTP_HOST según dónde se ejecute el backend:
#   - NestJS en el host (fuera de Docker): localhost (Mailpit publica 127.0.0.1:1025).
#   - Contenedor `backend` (perfil `app`): mailpit (nombre del servicio en la red `omr`);
#     `localhost` apuntaría al propio contenedor. Compose no sobrescribe SMTP_HOST como hace con
#     MONGODB_URI y REDIS_URL: ajustarlo en .env y levantar ambos perfiles
#     (docker compose --profile app --profile mail-dev up -d).
# Con NODE_ENV=production, `mailpit` y `localhost` hacen fallar el arranque (DEC-05).
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=true para TLS implícito (obligatorio con SMTP_PORT=465). Con false, fuera de local el
# servidor debe ofrecer STARTTLS o el envío falla (DEC-26). Tiempos máximos finitos, en milisegundos.
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-responder@example.test
MAIL_DRAIN_TIMEOUT_MS=10000

# Métricas internas (T-47, DEC-25): servidor HTTP aparte con solo GET /metrics. 0 = deshabilitado.
# METRICS_PORT debe ser distinto del puerto de la API y NUNCA publicarse fuera de la red interna.
# METRICS_HOST es una IP: 127.0.0.1 en el host; en un contenedor, la interfaz de la red interna
# (o 0.0.0.0 sin publicar el puerto en Compose).
METRICS_PORT=0
METRICS_HOST=127.0.0.1

# Solo desarrollo y pruebas: contraseña de las cuentas del seed 002-seed-roles-dev
# (mínimo 12 caracteres). No se usa en producción.
SEED_DEV_PASSWORD=cambiar_contrasena_de_cuentas_semilla
