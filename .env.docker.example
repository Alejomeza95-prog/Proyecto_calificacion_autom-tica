# Plantilla de variables para desarrollo local. Copiar a .env y reemplazar los marcadores.
# NUNCA escribir aquí credenciales reales: este archivo se versiona en Git.

# --- MongoDB (contenedor `mongo`) ---
MONGO_ROOT_USER=cambiar_usuario
MONGO_ROOT_PASSWORD=cambiar_contrasena_segura
# La misma contraseña codificada para URL (por ejemplo, % -> %25, @ -> %40).
# Se usa solo dentro de URIs mongodb://. Ver docs/onboarding/02-variables-entorno.md
MONGO_ROOT_PASSWORD_URLENCODED=cambiar_contrasena_segura
MONGO_DB=omr_preicfes
MONGO_PORT=27017

# --- Redis (contenedor `redis`, colas BullMQ) ---
REDIS_PORT=6379

# --- Para NestJS ejecutándose en el host (fuera de Docker) ---
MONGODB_URI=mongodb://cambiar_usuario:cambiar_contrasena_segura@localhost:27017/omr_preicfes?authSource=admin
REDIS_URL=redis://localhost:6379/0
